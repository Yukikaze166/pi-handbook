# nginx 配置示例：docsify 站点
# 用法：放入 /etc/nginx/conf.d/wiki.conf，替换 server_name 与证书路径后
#      sudo nginx -t && sudo systemctl reload nginx
#
# 证书可选用 certbot：
#   sudo certbot --nginx -d wiki.example.com
# 或云厂商签发的免费 DV 证书（将下面两个路径改为实际文件）。

server {
    listen 80;
    server_name wiki.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;                     # nginx < 1.25.1 改为 listen 443 ssl http2;
    server_name wiki.example.com;

    root /var/www/pi-handbook;
    index index.html;
    charset utf-8;

    ssl_certificate     /etc/letsencrypt/live/wiki.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wiki.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    location / {
        try_files $uri $uri/ =404;
    }

    # 禁止访问仓库内部目录与临时目录
    location ~ /\.(git|pi|github)/ {
        deny all;
        return 404;
    }

    # 配置文件目录按需隐藏（默认公开，内容与公开仓库一致）
    # location ^~ /config/ { deny all; return 404; }

    # 文档更新后立即生效
    location ~ \.md$ {
        add_header Cache-Control "no-cache";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # 静态资源可长期缓存
    location ~ ^/docsify/ {
        add_header Cache-Control "public, max-age=604800";
    }
}
